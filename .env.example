# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-your-token

# Публичный HTTPS-адрес этого сервера — нужен для карты (Mini App).
# Без него бот работает, но без кнопки «Карта».
PUBLIC_URL=https://example.com

# Порт веб-сервера (карта и API)
PORT=3000

# Файл базы данных SQLite
DB_PATH=./data/lctr.db
